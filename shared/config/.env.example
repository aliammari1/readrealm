# ReadRealm shared environment reference
# Canonical backend template: apps/api/.env.example

MONGODB_URL=mongodb://localhost:27017/readrealm
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ElevenLabs narration / voice agent
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_AGENT_ID=

# Optional book summaries
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.0-flash

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
MAX_JSON_BODY_SIZE=10mb
