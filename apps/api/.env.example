# ============================================================
# ReadRealm API - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values

# Database
MONGODB_URL=mongodb://localhost:27017/readrealm

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Email Service (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_specific_password

# Azure Cognitive Services - Text-to-Speech
AZURE_TTS_KEY=your_azure_tts_key
AZURE_TTS_ENDPOINT=https://your-region.tts.speech.microsoft.com/

# Azure Cognitive Services - Speech-to-Text (Real-time)
AZURE_REALTIME_KEY=your_azure_realtime_key
AZURE_REALTIME_ENDPOINT=https://your-region.stt.speech.microsoft.com/

# Google Generative AI (Gemini)
GOOGLE_AI_KEY=your_google_ai_api_key
GOOGLE_AI_MODEL=gemini-pro

# HuggingFace
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Server Configuration
NODE_ENV=development
PORT=3000
# pino log level: trace|debug|info|warn|error|fatal (pretty-printed in dev)
LOG_LEVEL=debug

# CORS Configuration
# Comma-separated allow-list of browser origins. Leave EMPTY to disable CORS
# (same-origin only) — the secure default. Use '*' only for throwaway local
# demos (the API logs a warning when wide-open).
# e.g. CORS_ORIGIN=https://app.readrealm.io,https://admin.readrealm.io
CORS_ORIGIN=

# Error tracking (optional) — Sentry. Leave SENTRY_DSN empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# File Upload
MAX_FILE_SIZE=104857600  # 100MB in bytes
UPLOAD_DIR=uploads/
