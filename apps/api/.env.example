# ReadRealm API environment
# Copy to .env and fill in real values. Never commit .env.

# Database
MONGODB_URL=mongodb://localhost:27017/readrealm

# Authentication
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

# Email / verification
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ElevenLabs
# Free tier is suitable for development/non-commercial testing.
# Commercial ReadRealm releases require a plan that grants commercial use.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_AGENT_ID=

# Local/self-hosted book summaries (no vendor API key)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
MAX_JSON_BODY_SIZE=10mb
